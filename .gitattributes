# 让跨平台开发的行尾一致，避免 shell 脚本在 Linux 上因为 CRLF 报错
* text=auto eol=lf

# Shell 脚本和 systemd unit 强制 LF (不然在 Linux 上执行会报 bad interpreter)
*.sh        text eol=lf
*.service   text eol=lf
*.conf      text eol=lf

# 二进制文件
*.png       binary
*.jpg       binary
*.zip       binary
*.gz        binary
*.db        binary
